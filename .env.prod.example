# Copy to .env.prod for docker compose — never commit real secrets.

# --- Public frontend URL (no trailing slash) ---
PUBLIC_APP_BASE_URL=https://your-domain.com

# --- PostgreSQL ---
PROD_DB_NAME=marketplace
PROD_DB_USER=marketplace
PROD_DB_PASSWORD=

# --- Security ---
APP_JWT_SECRET=

# --- CORS (comma-separated if multiple origins) ---
PROD_CORS_ORIGINS=https://your-domain.com

# --- Email (SendGrid) ---
SENDGRID_API_KEY=
EMAIL_DOMAIN=yourdomain.com
# Optional fallback when domain authentication is not configured:
EMAIL_FROM=

# --- Payments label (EFT/CASH in-app; no card gateway required) ---
PROD_PAYMENT_PROVIDER=stub

# --- Platform bank (provider subscription EFT) ---
APP_BANK_NAME=
APP_BANK_ACCOUNT_NAME=
APP_BANK_ACCOUNT_NUMBER=
APP_BANK_BRANCH_CODE=
APP_BANK_REFERENCE_HINT=Use your Provider Name as reference

# --- Subscription pricing (ZAR / month) ---
APP_SUBSCRIPTION_BASIC_MONTHLY=199
APP_SUBSCRIPTION_PREMIUM_MONTHLY=499

# --- Frontend build (empty when nginx proxies /api on same domain) ---
VITE_API_BASE=

# --- Online payments: PayFast (live; real merchant only) ---
# Startup fails if PAYFAST_SANDBOX=true, the merchant is the public sandbox merchant 10000100,
# a credential or the passphrase is missing, or PAYFAST_PUBLIC_BASE_URL is not https.
PAYFAST_ENABLED=false
PAYFAST_SANDBOX=false
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Public https URL of the backend; PayFast posts ITNs to {this}/api/public/payfast/notify
PAYFAST_PUBLIC_BASE_URL=https://api.example.com
PAYFAST_VALIDATE_WITH_SERVER=true

# --- Online payments: Peach Payments (live; PEACH_SANDBOX=true refuses to start on UAT/PROD) ---
PEACH_ENABLED=false
PEACH_SANDBOX=false
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=
PEACH_ENTITY_ID=
PEACH_SECRET_TOKEN=
